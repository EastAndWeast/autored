{
  "mcpServers": {
    "xhs-ai-assistant": {
      "command": "/usr/bin/env",
      "args": [
        "python3",
        "-m",
        "app.mcp.server"
      ],
      "cwd": "{{PROJECT_DIR}}",
      "env": {
        "PYTHONUNBUFFERED": "1",
        "XHS_DATA_DIR": "{{PROJECT_DIR}}/data"
      }
    }
  }
}

